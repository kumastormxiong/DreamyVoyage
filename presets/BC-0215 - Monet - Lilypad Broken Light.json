{
  "baseVals": {
    "wave_mode": 3,
    "wave_a": 0.65,
    "wave_scale": 1.05,
    "decay": 0.986,
    "gammaadj": 1.03,
    "zoom": 1.002,
    "rot": 0.001,
    "warp": 0.011,
    "wave_r": 0.3,
    "wave_g": 0.7,
    "wave_b": 0.5
  },
  "init_eqs_str": "a.q1=0; a.q2=0;",
  "frame_eqs_str": "a.q1+=.004; a.q2=.94*a.q2+.06*a.mid_att; a.dy=.0005*Math.sin(a.q1);",
  "pixel_eqs_str": "a.dx+=.0025*Math.sin(a.rad*19.-a.q1);",
  "warp": "shader_body { vec2 p=uv+vec2(sin(uv.y*12.+q1),cos(uv.x*9.-q1))*.0018; ret=texture(sampler_main, p).xyz*.989; }",
  "comp": "shader_body { vec3 c=texture(sampler_main, uv).xyz; vec3 water=vec3(.08,.3,.36), lilac=vec3(.65,.42,.7), sun=vec3(.95,.78,.35); ret=mix(water,lilac,c.r)+sun*texture(sampler_blur1, uv).xyz*.8; }"
}
