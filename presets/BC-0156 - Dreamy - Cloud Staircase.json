  "warp": "shader_body { vec2 p=uv+vec2(.0015*sin(uv.y*7.+q1),.001*cos(uv.x*6.-q1)); ret=texture(sampler_main, p).xyz*.988; }",
  "comp": "shader_body { vec3 c=texture(sampler_main, uv).xyz; vec3 sky=vec3(.16,.2,.45), cloud=vec3(.85,.72,.92), peach=vec3(1.,.55,.58); ret=sky+mix(cloud,peach,c.r)*(.4+c.g*1.3); }"
