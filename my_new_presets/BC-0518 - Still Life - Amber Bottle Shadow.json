{
  "baseVals": {
    "wave_mode": 2,
    "wave_a": 0.5,
    "wave_scale": 0.8,
    "decay": 0.99,
    "gammaadj": 0.99,
    "zoom": 1.0008,
    "rot": 0,
    "warp": 0.005,
    "wave_r": 0.65,
    "wave_g": 0.38,
    "wave_b": 0.12
  },
  "init_eqs_str": "a.q1=0;",
  "frame_eqs_str": "a.q1=.97*a.q1+.03*a.bass_att; a.dx=.0002*Math.sin(a.q1);",
  "pixel_eqs_str": "a.dy+=.001*Math.sin(a.y*5.+a.q1);",
  "warp": "shader_body { ret=texture(sampler_main, uv+vec2(.0004*sin(uv.y*5.+q1),0.)).xyz*.995; }",
  "comp": "shader_body { vec3 c=texture(sampler_main, uv).xyz; vec3 table=vec3(.45,.3,.22), bottle=vec3(.78,.42,.08), glint=vec3(1.,.8,.35); ret=mix(table,bottle,c.r)+glint*texture(sampler_blur1, uv).xyz*.3; }"
}
