{
  "baseVals": {
    "wave_mode": 1,
    "wave_a": 0.72,
    "wave_scale": 1.0,
    "decay": 0.984,
    "gammaadj": 1.14,
    "zoom": 1.002,
    "rot": 0.001,
    "warp": 0.013,
    "wave_r": 0.2,
    "wave_g": 0.85,
    "wave_b": 0.7
  },
  "init_eqs_str": "a.q1=0; a.q2=0;",
  "frame_eqs_str": "a.q1+=.003; a.q2=.93*a.q2+.07*a.mid_att; a.dx=.0005*Math.sin(a.q1);",
  "pixel_eqs_str": "a.dx+=.003*Math.sin(a.y*10.+a.q1)+.001*Math.cos(a.y*27.);",
  "warp": "shader_body { vec2 p=uv+vec2(.002*sin(uv.x*10.+q1),-.001*cos(uv.x*17.-q1)); ret=texture(sampler_main, p).xyz*.988; }",
  "comp": "shader_body { vec3 c=texture(sampler_main, uv).xyz; vec3 night=vec3(.015,.035,.08), green=vec3(.15,.8,.5), lilac=vec3(.45,.3,.8); ret=night+mix(green,lilac,c.b)*(.45+c.g*1.6); }"
}
