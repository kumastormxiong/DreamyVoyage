{
  "baseVals": {
    "wave_mode": 7,
    "wave_a": 0.85,
    "wave_scale": 1.25,
    "decay": 0.936,
    "gammaadj": 1.3,
    "zoom": 1.026,
    "rot": 0.028,
    "warp": 0.1,
    "wave_r": 1,
    "wave_g": 0.12,
    "wave_b": 0.75
  },
  "init_eqs_str": "a.q1=0; a.q2=0;",
  "frame_eqs_str": "a.q1+=.032+.05*a.bass_att; a.q2=.82*a.q2+.18*a.bass_att; a.rot=.024+.04*a.q2;",
  "pixel_eqs_str": "a.zoom+=.025*Math.sin(a.rad*13.-a.q1);",
  "warp": "shader_body { vec2 p=uv+vec2(sin(uv.y*14.+q1),cos(uv.x*11.-q1))*.007*(1.+q2); ret=texture(sampler_main, p).xyz*.95; }",
  "comp": "shader_body { vec3 c=texture(sampler_main, uv).xyz; vec3 pink=vec3(1.,.02,.55), lime=vec3(.3,1.,.05), indigo=vec3(.12,.08,.85); ret=mix(indigo,pink,c.r)+lime*c.g*1.4+texture(sampler_blur2, uv).xyz*1.2; }"
}
