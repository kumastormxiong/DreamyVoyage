{
  "baseVals": {
    "wave_mode": 5,
    "wave_a": 0.6,
    "wave_scale": 0.95,
    "decay": 0.981,
    "gammaadj": 1.04,
    "zoom": 1.002,
    "rot": 0.001,
    "warp": 0.012,
    "wave_r": 0.65,
    "wave_g": 0.45,
    "wave_b": 0.75
  },
  "init_eqs_str": "a.q1=0;",
  "frame_eqs_str": "a.q1+=.0035; a.q2=.95*a.q2+.05*a.mid_att; a.dy=.0003;",
  "pixel_eqs_str": "a.dx+=.002*Math.sin(a.y*20.+a.q1);",
  "warp": "shader_body { vec2 p=uv+vec2(.001*sin(uv.y*14.+q1),.001*cos(uv.x*8.)); ret=texture(sampler_main, p).xyz*.989; }",
  "comp": "shader_body { vec3 c=texture(sampler_main, uv).xyz; vec3 stone=vec3(.55,.55,.62), lilac=vec3(.62,.42,.7), sun=vec3(.95,.72,.34); ret=mix(stone,lilac,c.b)+sun*texture(sampler_blur1, uv).xyz*.65; }"
}
